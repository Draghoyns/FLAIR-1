{
    "input_model": {
        "type": "PytorchModel",
        "model_path": "src/zone_detect/metrics/frozen_config.yaml",
        "model_script": "src/zone_detect/test/onnx/script_olive.py",
        "model_loader": "load_model_from_cfg_path",
        "dummy_inputs_func": "dummy"
    },
        "passes" : {
            "OnnxConv": {
            "type": "OnnxConversion",
            "device": "cuda"},
        "ODQ": {
            "type": "OnnxDynamicQuantization",
            "precision": "int8",
            "op_types_to_exclude": [
                "Conv"
            ]
        },
        "gs": {
            "type": "GraphSurgeries",
            "surgeries": [
                { "surgeon": "InferSHapes" },
                { "surgeon": "AttentionMaskToSequenceLengths" },
                { "surgeon": "SimplifiedLayerNormToL2Norm" }
            ],
            "save_as_external_data": true
        }
    },
    "log_severity_level" : 1,
    "output_dir" : "0testing_saves/onnx/noconv_from_pt"
}